{
  "openapi": "3.0.0",
  "info": {
    "title": "TaskFlow Multi-Tenant Backend API",
    "version": "1.0.0",
    "description": "Production-grade multi-tenant project management API with authentication, RBAC, background queues, and task management."
  },
  "servers": [
    {
      "url": "https://taskflow-65nm.onrender.com/api",
      "description": "Production Server (Render)"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["Health"],
        "security": [],
        "responses": {
          "200": { "description": "Server is healthy" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register new user and organization",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name", "orgName", "orgSlug"],
                "properties": {
                  "email": { "type": "string", "example": "ishita.demo@taskflow.com" },
                  "password": { "type": "string", "example": "Password123!" },
                  "name": { "type": "string", "example": "Ishita Patil" },
                  "orgName": { "type": "string", "example": "Demo Innovations" },
                  "orgSlug": { "type": "string", "example": "demo-innovations" }
                }
              },
              "example": {
                "email": "ishita.demo@taskflow.com",
                "password": "Password123!",
                "name": "Ishita Patil",
                "orgName": "Demo Innovations",
                "orgSlug": "demo-innovations"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User and organization registered successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email or orgSlug already exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user to organization",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "orgSlug"],
                "properties": {
                  "email": { "type": "string", "example": "ishita.demo@taskflow.com" },
                  "password": { "type": "string", "example": "Password123!" },
                  "orgSlug": { "type": "string", "example": "demo-innovations" }
                }
              },
              "example": {
                "email": "ishita.demo@taskflow.com",
                "password": "Password123!",
                "orgSlug": "demo-innovations"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful - returns JWT access and refresh tokens" },
          "401": { "description": "Invalid credentials or not an org member" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh JWT access token",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string", "description": "Paste the refreshToken received from /auth/login response" }
                }
              },
              "example": {
                "refreshToken": "<paste your refreshToken from login response here>"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token refreshed successfully - returns new access and refresh token pair" },
          "401": { "description": "Invalid or revoked refresh token" }
        }
      }
    },
    "/projects": {
      "get": {
        "summary": "List organization projects",
        "tags": ["Projects"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "example": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "example": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of projects" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create project",
        "tags": ["Projects"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "Q3 Cloud Migration" },
                  "description": { "type": "string", "example": "Migrate all microservices to containerized Kubernetes cluster" }
                }
              },
              "example": {
                "name": "Q3 Cloud Migration",
                "description": "Migrate all microservices to containerized Kubernetes cluster"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Project created successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/projects/{id}/dashboard": {
      "get": {
        "summary": "Get project dashboard analytics",
        "tags": ["Projects"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Project UUID (copy from POST /projects response)",
            "example": "paste-project-id-here"
          }
        ],
        "responses": {
          "200": { "description": "Project stats - total tasks, overdue count, status breakdown" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Project not found" }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List and filter tasks",
        "tags": ["Tasks"],
        "parameters": [
          { "name": "projectId", "in": "query", "schema": { "type": "string" }, "description": "Filter by project UUID" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["todo", "in_progress", "review", "done"] } },
          { "name": "priority", "in": "query", "schema": { "type": "string", "enum": ["low", "medium", "high", "urgent"] } },
          { "name": "assigneeId", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Paginated list of filtered tasks" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create task",
        "tags": ["Tasks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["projectId", "title"],
                "properties": {
                  "projectId": { "type": "string", "description": "Paste Project UUID from POST /projects response" },
                  "title": { "type": "string", "example": "Setup Redis Cache Layer" },
                  "description": { "type": "string", "example": "Configure BullMQ workers with exponential backoff retries" },
                  "status": { "type": "string", "enum": ["todo", "in_progress", "review", "done"], "example": "todo" },
                  "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"], "example": "high" },
                  "dueDate": { "type": "string", "format": "date", "example": "2026-09-30", "description": "Format: YYYY-MM-DD" }
                }
              },
              "example": {
                "projectId": "<paste-project-id-here>",
                "title": "Setup Redis Cache Layer",
                "description": "Configure BullMQ workers with exponential backoff retries",
                "priority": "high",
                "dueDate": "2026-09-30"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Task created successfully" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "summary": "Get task by ID",
        "tags": ["Tasks"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Task UUID" }
        ],
        "responses": {
          "200": { "description": "Task details" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      },
      "put": {
        "summary": "Update task",
        "tags": ["Tasks"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Task UUID (copy from POST /tasks response)" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "status": { "type": "string", "enum": ["todo", "in_progress", "review", "done"], "example": "in_progress" },
                  "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
                  "dueDate": { "type": "string", "format": "date", "description": "Format: YYYY-MM-DD" }
                }
              },
              "example": {
                "status": "in_progress"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Task updated successfully" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      },
      "delete": {
        "summary": "Delete task (soft delete)",
        "tags": ["Tasks"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Task UUID" }
        ],
        "responses": {
          "200": { "description": "Task soft-deleted successfully" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found" }
        }
      }
    },
    "/tasks/{id}/assign": {
      "post": {
        "summary": "Assign user to task (triggers BullMQ email notification job)",
        "tags": ["Tasks"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Task UUID" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["userId"],
                "properties": {
                  "userId": { "type": "string", "description": "User UUID to assign (must be in same organization)" }
                }
              },
              "example": {
                "userId": "<paste-user-id-from-login-response>"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User assigned and email notification job queued in Redis via BullMQ" },
          "400": { "description": "User not in same organization" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Check BullMQ background job status",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Job ID returned from /tasks/:id/assign" }
        ],
        "responses": {
          "200": { "description": "Returns job state: waiting, active, completed, failed" },
          "404": { "description": "Job not found" }
        }
      }
    }
  }
}
